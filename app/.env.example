# Copy to .env.local and fill in. Both values are the project's public settings
# (Supabase dashboard > Project Settings > API). Never put the server (service role) key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Development only: look at the screens with pretend data and no account.
#   EXPO_PUBLIC_DEMO=1 npm run web
# Ignored in a production build (the demo code is not included there). Use any placeholder values above.
